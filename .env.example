# LLM provider selection and credentials (see docs/ARCHITECTURE.md §2.1 — LLMProvider abstraction)
# LLM_PROVIDER: anthropic | openai | gemini (gemini has a free tier, no billing required)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Minimum seconds between two LLM calls (0 = no pause). Gemini free tier allows
# 5 requests per minute: use 13. Transient 429/503 errors are retried automatically.
LLM_MIN_INTERVAL_SECONDS=0

# Database (see docs/PRD.md §20)
DATABASE_URL=sqlite:///data/ai_daily.db

# Default edition language when --language is not passed (see docs/ARCHITECTURE.md §5.1)
DEFAULT_LANGUAGE=it

# Freshness window: max age in days of an article's published_at to be
# collected/clustered (see docs/ARCHITECTURE.md §4.15)
NEWS_LOOKBACK_DAYS=2

# Telegram delivery (post-MVP, see docs/PRD.md §28)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
