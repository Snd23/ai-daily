# LLM provider selection and credentials (see docs/ARCHITECTURE.md §2.1 — LLMProvider abstraction)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (see docs/PRD.md §20)
DATABASE_URL=sqlite:///data/ai_daily.db

# Default edition language when --language is not passed (see docs/ARCHITECTURE.md §5.1)
DEFAULT_LANGUAGE=it

# Telegram delivery (post-MVP, see docs/PRD.md §28)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
